{
  "id": "./",
  "name": "MaqamAI — Hüsn-i Tilavet Stüdyosu",
  "short_name": "MaqamAI",
  "description": "Kur'an'ı makamla okumayı öğreten koç: ayet ve aşr seçimi, canlı perde takibi, gerçek kurra kayıtlarıyla meşk",
  "lang": "tr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A1A1E",
  "theme_color": "#0A1A1E",
  "categories": [
    "education",
    "music",
    "lifestyle"
  ],
  "display_override": [
    "standalone"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "screenshots": [
    {
      "src": "screens/studio.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Okurken perdenizi canlı görün"
    },
    {
      "src": "screens/report.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Her ayete bir rapor"
    },
    {
      "src": "screens/reader.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Tecvid renkleri ve okunuş"
    },
    {
      "src": "screens/home.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Günün aşrı ve haftalık hedef"
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Okumaya başla",
      "short_name": "Oku",
      "url": "./?action=read",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Kur'an'dan seç",
      "short_name": "Kur'an",
      "url": "./?action=quran",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Üstad kaydı ekle",
      "short_name": "Üstad ekle",
      "url": "./?action=import",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".m4a",
            ".aac",
            ".wav",
            ".ogg",
            ".oga",
            ".opus",
            ".flac",
            ".webm",
            ".mp4",
            ".mov",
            ".3gp",
            ".amr"
          ]
        }
      ]
    }
  }
}